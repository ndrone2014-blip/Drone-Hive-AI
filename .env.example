# ─────────────────────────────────────────────────────────────
#  Drone Hive AI — environment variables
#
#  LOCAL:   copy this file to ".env" (same folder) and fill in values.
#  NETLIFY: add the same names in Netlify → Project (or Site) configuration →
#           Environment variables (scope must include "Functions"),
#           then redeploy.
#
#  The app runs fine with NOTHING set — it just shows
#  "AI not connected" until you add a provider.
#  Never put API keys in files under /public.
# ─────────────────────────────────────────────────────────────

# ── Google Gemini (priority #1 in Automatic mode, free tier, reads images) ──
# Get a key at https://aistudio.google.com/apikey. Mark it as a secret on Netlify.
# (If Gemini is already set up through the OPENAI_COMPAT_* variables pointing at
#  generativelanguage.googleapis.com, it's picked up automatically — no change needed.)
GEMINI_API_KEY=
# Or use GOOGLE_API_KEY instead (safest on Netlify: Netlify's AI Gateway never
# fills it with a placeholder). A Netlify placeholder in GEMINI_API_KEY is ignored.
# GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_MODELS=gemini-flash-latest,gemini-flash-lite-latest
# How much Gemini "thinks" before answering: low (default) | medium | high | off
# GEMINI_REASONING_EFFORT=low

# ── Vibe AI (Mistral AI) — one provider, free "Experiment" plan, reads images ──
# Create a key at https://console.mistral.ai/api-keys. Mark it as a secret on Netlify.
MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-medium-latest
# MISTRAL_MODELS=mistral-medium-latest,mistral-small-latest,codestral-latest
# MISTRAL_VISION_MODELS=mistral-medium-latest,mistral-small-latest

# ── Option A: Anthropic Claude ───────────────────────────────
# Get a key at https://console.anthropic.com (API usage is billed by Anthropic).
ANTHROPIC_API_KEY=
# Default model and the list shown in Settings (comma-separated, optional)
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_MODELS=claude-sonnet-5-5,claude-haiku-5-5,claude-opus-5-5

# ── Option B: Ollama ─────────────────────────────────────────
# Ollama Cloud: create a key at https://ollama.com (Settings → Keys).
OLLAMA_API_KEY=
# Default model and the list shown in Settings (use names from ollama.com)
# OLLAMA_MODEL=gpt-oss:120b
# OLLAMA_MODELS=gpt-oss:120b,gpt-oss:20b
# Image-capable model used when a message has images (cloud default: qwen3-vl:235b)
# OLLAMA_VISION_MODELS=qwen3-vl:235b
# Local Ollama on your PC instead of the cloud (no key needed, local dev only):
# OLLAMA_BASE_URL=http://localhost:11434/v1
#   (Safety: on the public Netlify site a localhost / private-network address is
#    ignored, so visitors can never reach an Ollama running on your computer.)

# ── Option C: Groq (free plan, very fast) ─────────────────
# Create a key at https://console.groq.com/keys (starts with gsk_). Mark it as a secret on Netlify.
GROQ_API_KEY=
# Default model and the list shown in Settings (exact IDs from console.groq.com/docs/models)
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_MODELS=openai/gpt-oss-120b,llama-3.3-70b-versatile,openai/gpt-oss-20b
# Image-capable model (https://console.groq.com/docs/vision)
# GROQ_VISION_MODELS=qwen/qwen3.8-27b

# ── Option D: OpenRouter (many free models, one key) ───────
# Create a key at https://openrouter.ai/keys (starts with sk-or-). Mark it as a secret on Netlify.
# Only free models (":free" or the "openrouter/free" router) are used, so it can't spend credits.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/free
# OPENROUTER_MODELS=openrouter/free,openai/gpt-oss-120b:free
# Model used for messages with images (the free router picks a free model that can see them)
# OPENROUTER_VISION_MODELS=openrouter/free
# Set to true ONLY if you want to allow paid models (uses your OpenRouter credits).
# OPENROUTER_ALLOW_PAID=false

# ── Option E: any other OpenAI-compatible API ─────────────────────
# Works with many services, including some with free tiers.
# OPENAI_COMPAT_NAME=My Provider
# OPENAI_COMPAT_BASE_URL=https://example.com/v1
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_MODEL=
# OPENAI_COMPAT_MODELS=
# OPENAI_COMPAT_VISION_MODELS=   (only if that service's model can read images)

# Netlify's AI Gateway auto-adds a Claude connection to every site and bills it
# to your Netlify credits. Drone Hive AI ignores it unless you set this to true.
# ALLOW_NETLIFY_AI_GATEWAY=false

# ── Memory ───────────────────────────────────────────────────
# Memories are stored with each account in Firestore automatically when sign-in
# (FIREBASE_API_KEY + FIREBASE_PROJECT_ID) and the Firestore service account
# (FIREBASE_CLIENT_EMAIL + FIREBASE_PRIVATE_KEY) are both set. Otherwise each
# browser keeps them itself. Set to "browser" to always keep them in the browser.
# MEMORY_STORE=

# ── General ──────────────────────────────────────────────────
# Automatic is the standard mode for everyone. This only sets the provider for "Default" mode:
# auto | gemini | mistral | openrouter | groq | ollama | anthropic | openai-compatible
# (auto = the first connected one in this order: Gemini, Mistral, OpenRouter, Groq, Ollama, Anthropic, OpenAI-compatible).
# Don't mark this one as secret on Netlify.
# AI_PROVIDER=auto
# In Default mode, if that provider is busy or down before it starts answering,
# try the others (Gemini → Mistral → OpenRouter → Groq → Ollama). Set false to turn off.
# AI_DEFAULT_FALLBACK=true
# Seconds to wait for a provider to START replying before moving to the next one.
# AI_FIRST_TOKEN_SECONDS=35

# ── Accounts: sign in with Google or email (Firebase, free) ──
# When FIREBASE_API_KEY and FIREBASE_PROJECT_ID are set, everyone must sign in
# (Google, or email + password with a verified email) before using the AI.
# Get them from Firebase console → Project settings → General → Your apps → Web app.
# These are PUBLIC values (Firebase puts them in every website), not secrets.
# FIREBASE_API_KEY=
# FIREBASE_PROJECT_ID=
# Optional — defaults to <project-id>.firebaseapp.com
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_APP_ID=
# Set to false to keep the Firebase values but turn sign-in off.
# AUTH_REQUIRED=true

# ── Security & token limits ──────────────────────────────────
# Password for the AI. STRONGLY recommended: with it set, only people you give
# the code to can use your AI. Use 12+ random characters. Wrong guesses are
# locked out for 15 minutes after 5 tries. Mark it as a secret on Netlify.
# Enter the same code in the app: Settings → AI Configuration.
# DRONEHIVE_ACCESS_CODE=

# Reply lengths (tokens). Medium is the standard length for every reply;
# users can pick Short in Settings. AI_MAX_OUTPUT_TOKENS is the hard ceiling.
# AI_MEDIUM_RESPONSE_TOKENS=8000
# AI_SHORT_RESPONSE_TOKENS=2000
# AI_MAX_OUTPUT_TOKENS=8000
# Max tokens (estimated) one request can send, incl. chat history. Older
# messages are dropped to fit. Default 12000.
# AI_MAX_INPUT_TOKENS=12000
# Max characters in one message. Default 16000.
# AI_MAX_MESSAGE_CHARS=16000
# Stop any reply that runs longer than this (seconds). Default 120.
# AI_MAX_REPLY_SECONDS=120

# Images: max per message and max size of each (bytes, after the browser shrinks it).
# AI_MAX_IMAGES_PER_REQUEST=4
# AI_MAX_IMAGE_BYTES=4000000

# Per-user limits (per signed-in account, and per IP address at 3x). Enforced on
# the server — refreshing, new sessions or other browsers don't reset them.
# Netlify also enforces a hard 10 requests/minute per IP on /api/chat.
# AI_RATE_LIMIT_PER_MINUTE=6
# AI_HOURLY_REQUESTS_PER_USER=30
# AI_DAILY_REQUESTS_PER_USER=100
# AI_DAILY_TOKENS_PER_USER=25000
# AI_WEEKLY_TOKENS_PER_USER=100000     (week = Monday 00:00 UTC to Sunday)
# AI_MONTHLY_TOKENS_PER_USER=300000    (calendar month, UTC)
# Replies one person can have running at the same time.
# AI_MAX_CONCURRENT_PER_USER=2

# Limits for EVERYONE combined, per day (UTC). When reached, new AI requests
# stop until midnight UTC or until you raise the limit.
# AI_GLOBAL_DAILY_REQUESTS=1500
# AI_GLOBAL_DAILY_TOKENS=3000000

# Emergency stop: set to true (and redeploy) to pause all AI replies.
# Faster: with Firestore set up (below), set emergencyStop=true in the
# config/limits document in the Firebase console — applies in ~30 seconds.
# AI_EMERGENCY_STOP=false

# ── Shared usage counters (Firestore, free Spark plan) ───────
# Without these, limits are kept in memory per Netlify edge server (they reset
# when it restarts). With them, every server shares the same counters.
# Firebase console → Project settings → Service accounts → Generate new private key.
# Copy two values from the downloaded JSON file (never commit that file):
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY=<the whole "private_key" value from the JSON file, BEGIN/END lines included>
# (or put the whole JSON, raw or base64, in FIREBASE_SERVICE_ACCOUNT)
# Force in-memory limits even when the above are set:
# USAGE_STORE=memory

# Extra websites allowed to call your API (comma-separated). Normally leave empty.
# ALLOWED_ORIGINS=

# Replace the assistant's built-in personality (optional)
# (The "Drone Hive AI" name and identity are always added first and can't be replaced here.)
# AI_SYSTEM_PROMPT=

# Allow users' "Custom instructions" from Settings (default true)
# AI_ALLOW_CUSTOM_INSTRUCTIONS=true

# Local dev server port (default 8888)
# PORT=8888
